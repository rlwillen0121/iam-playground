FROM node:22.14.0-alpine AS build

WORKDIR /src
COPY workbench/package.json workbench/build.mjs workbench/index.html workbench/app.css workbench/app.js ./
RUN node build.mjs

FROM nginx:1.27.4-alpine

COPY infra/nginx/workbench.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist/index.html /src/dist/app.css /src/dist/app.js /usr/share/nginx/html/
